# Copy this file to .env and fill in your own values. Never commit .env.

# Where the app reads tickets and saves results: local, google or hubspot
DATA_SOURCE=local

# Step 4: Google Drive (see docs/setup-google-drive.md)
GOOGLE_CREDENTIALS_FILE=credentials/google-service-account.json
GOOGLE_SHEET_ID=
GOOGLE_DRIVE_FOLDER_ID=

# Step 5 onward: Claude API
ANTHROPIC_API_KEY=

# Step 9: HubSpot (see docs/setup-hubspot.md). Never share this token.
HUBSPOT_ACCESS_TOKEN=
